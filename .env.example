# ============================================================
# ReformaPlus ROI - Variáveis de Ambiente (EXEMPLO)
# Copie este arquivo para `.env` e `.env.local` e preencha
# com os valores DO SEU PROJETO no Supabase e Vercel.
#
# O arquivo .env NUNCA deve ser commitado (já está no .gitignore)
# ============================================================

# ---------- SUPABASE (obrigatório para modo CLOUD) ----------
# Encontre estes valores em: https://supabase.com/dashboard/project/_/settings/api
# Project Settings → API

# Project URL (ex: https://abc123xyz.supabase.co)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# anon public key (NÃO É A service_role! é a "anon public" mesmo)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo-exemplo-exemplo

# service_role key (SÓ use em Edge Functions / server-side. NUNCA exponha no browser!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.segredo-aqui-somente-server

# Project Ref ID (8 chars, parte da URL: https://supabase.com/dashboard/project/ESTE-VALOR)
PROJECT_REF=abc123xyz

# ---------- SUPABASE STORAGE (opcional - recibos anexados) ----------
# Nome do bucket criado em Storage (Sugestão: "receipts")
VITE_SUPABASE_BUCKET_RECEIPTS=receipts

# ---------- VERCEL / DEPLOY (opcional) ----------
# VERCEL_URL é setado automaticamente pelo Vercel em deploy
# VERCEL_ENV = production | preview | development
VERCEL_ENV=development

# Desativa completamente o Supabase e roda 100% local-first?
# true  → PWA offline total, sem sync (modo original v1.x)
# false → usa Supabase quando disponível, fila de sync local quando offline
VITE_LOCAL_ONLY=false
