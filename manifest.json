{
  "name": "ReformaPlus ROI - Gestão de Reforma e Flip Imobiliário",
  "short_name": "ReformaPlus",
  "description": "Controle financeiro, gestão de materiais, serviços e cálculo de ROI para reformas e revenda imobiliária.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "window-control-overlay", "minimal-ui", "browser"],
  "background_color": "#ffffff",
  "theme_color": "#10b981",
  "orientation": "portrait-primary",
  "lang": "pt-BR",
  "dir": "ltr",
  "categories": ["business", "finance", "productivity"],
  "launch_handler": {
    "client_mode": "auto",
    "route_to": "auto",
    "navigate_existing_client": "always"
  },
  "protocol_handlers": [
    {
      "protocol": "web+reformaplus",
      "url": "/?launch=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "file_handlers": [
    {
      "action": "/?launch=receipts&utm_source=pwa_file_handler",
      "accept": {
        "image/*": [".png", ".jpg", ".jpeg", ".webp", ".gif"]
      },
      "name": "Recibos e Fotos da Obra",
      "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/?launch=share_target&utm_source=pwa_share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "photos", "accept": ["image/*"], "maxSize": 2621440 }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Novo Lançamento",
      "short_name": "Lançamentos",
      "description": "Criar novo lançamento de despesa ou receita",
      "url": "/?launch=despesas&utm_source=pwa_shortcut",
      "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Dashboard ROI",
      "short_name": "Dashboard",
      "description": "Visão geral do projeto atual",
      "url": "/?launch=dashboard&utm_source=pwa_shortcut",
      "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Meus Imóveis",
      "short_name": "Imóveis",
      "description": "Gerenciar lista de imóveis cadastrados",
      "url": "/?launch=imovels&utm_source=pwa_shortcut",
      "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "icons": [
    {
      "src": "./assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
